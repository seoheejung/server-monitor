# MongoDB 기본 설정 파일

storage:
  # MongoDB 기본 데이터 저장 경로
  dbPath: /var/lib/mongo

systemLog:
  destination: file
  logAppend: true
  path: /var/log/mongodb/mongod.log

net:
  port: 27017

  # 운영 서버에서는 로컬 앱만 붙는 구조이므로 외부 직접 접근 차단, 로컬 루프백만 허용
  bindIp: 127.0.0.1

processManagement:
  # systemd 환경에서 포그라운드 실행
  fork: false

{% if mongodb_auth_enabled %}
security:
  # 인증 활성화
  authorization: enabled
{% endif %}