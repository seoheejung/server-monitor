# MongoDB 저장 경로 설정
storage:
  dbPath: /var/lib/mongo

# MongoDB 로그 파일 설정
systemLog:
  destination: file
  logAppend: true
  path: /var/log/mongodb/mongod.log

# 로컬 서버 전용 포트/바인딩 설정
net:
  port: 27017
  bindIp: 127.0.0.1

# 프로세스 기본 설정
processManagement:
  timeZoneInfo: /usr/share/zoneinfo

# 인증 활성화 여부를 Ansible 변수로 제어
security:
  authorization: {{ 'enabled' if mongodb_auth_enabled | bool else 'disabled' }}