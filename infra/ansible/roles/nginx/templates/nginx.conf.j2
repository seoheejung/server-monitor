server {
    # 외부 접근 포트
    listen {{ nginx_listen_port }};

    {% for svc in nginx_upstreams %}

    # /monitor → /monitor/ 리다이렉트 (없으면 404 발생)
    location = {{ svc.path }} {
        return 301 {{ svc.path }}/;
    }

    # 실제 reverse proxy
    location {{ svc.path }}/ {
        proxy_pass http://{{ svc.host }}:{{ svc.port }}/;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # 연결/응답 타임아웃 (운영 안정성)
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
    }

    {% endfor %}
}