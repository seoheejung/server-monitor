[Unit]
Description=Server Monitor
After=network.target mongod.service
Requires=mongod.service

[Service]
User={{ app_user }}
Group={{ app_group }}
WorkingDirectory={{ app_dir }}
EnvironmentFile={{ env_file }}

# app_dir 바로 아래에 main.py가 배치되는 구조 기준
ExecStart={{ venv_path }}/bin/uvicorn main:app --host ${HOST} --port ${PORT}

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target