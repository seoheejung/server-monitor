# MongoDB 인증 URI (앱은 관리자 계정이 아니라 전용 계정으로 접속)
MONGO_URL=mongodb://{{ mongodb_app_username }}:{{ mongodb_app_password }}@localhost:27017/{{ mongodb_app_database }}?authSource={{ mongodb_app_database }}

# 앱이 사용하는 DB 이름
DB_NAME={{ mongodb_app_database }}
COLLECTION_NAME=known_processes

# FastAPI 실행 설정
DEBUG=False
HOST=0.0.0.0
PORT=8000